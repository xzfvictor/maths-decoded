{
  "name": "maths-decoded",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/index.ts",
    "dev:all": "concurrently -n web,api -c blue,magenta \"npm:dev\" \"npm:dev:server\"",
    "start:server": "node --import tsx server/index.ts",
    "stop:server": "tsx scripts/stop-server.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check:coverage": "tsx scripts/check-coverage.ts",
    "check:exercises": "tsx scripts/verify.ts",
    "test:regenerate": "tsx scripts/test-regenerate.ts",
    "seed:intros": "tsx scripts/seed-intros.ts",
    "generate:audio": "tsx scripts/generate-audio.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "hono": "^4.12.32",
    "katex": "^0.16.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/katex": "^0.16.7",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "concurrently": "^10.0.4",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
