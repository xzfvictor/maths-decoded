# MathsDecoded — local environment configuration.
# Copy to `.env` and fill in your real values.
#
# These variables are read by `scripts/generate-audio.ts` (offline audio
# generation) AND by `server/index.ts` (live exercise regeneration).
# In self-host, the same env is set in your process manager / systemd unit.
# In Vercel, set them under Project → Settings → Environment Variables.

# Anthropic-compatible base URL. Defaults to minimax's anthropic surface.
ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic

# Bearer token. REQUIRED. The server refuses to call M3 without it.
# Do not commit your real token.
ANTHROPIC_AUTH_TOKEN=replace-me

# Model name. Defaults to MiniMax-M3 if unset.
ANTHROPIC_MODEL=MiniMax-M3

# HTTP port for the regenerate server (self-host only). Defaults to 8787.
# In production, run behind nginx/caddy with a `/api/` proxy to this port.
PORT=8787
