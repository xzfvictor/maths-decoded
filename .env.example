# MathsDecoded — local environment configuration.
# Copy to `.env` and fill in your real values.
#
# These variables are read by `scripts/generate-audio.ts` (offline audio
# generation) AND by `server/index.ts` (live exercise regeneration).
# In self-host, the same env is set in your process manager / systemd unit.
# In Vercel, set them under Project → Settings → Environment Variables.

# Anthropic-compatible base URL. Defaults to minimax's anthropic surface.
ANTHROPIC_BASE_URL=https://api.minimaxi.com/anthropic

# Bearer token. REQUIRED. The server refuses to call M3 without it.
# Do not commit your real token.
ANTHROPIC_AUTH_TOKEN=replace-me

# Model name. Defaults to MiniMax-M3 if unset.
ANTHROPIC_MODEL=MiniMax-M3

# HTTP port for the regenerate server (self-host only). Defaults to 8787.
# In production, run behind nginx/caddy with a `/api/` proxy to this port.
PORT=8787

# ---------------------------------------------------------------------------
# Auth (session cookie signing).
#
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Without this set, the server boots with an ephemeral dev secret and warns
# loudly — sessions won't survive a restart. Set this in any non-dev deploy.
AUTH_SECRET=

# Optional. Comma-separated list of previous secrets for graceful rotation.
# Tokens signed with an old secret keep verifying while the new secret signs
# new sessions. Once verification traffic dies down, drop the old secret.
AUTH_PREVIOUS_SECRETS=

# Optional. Directory for the server-side progress JSON store.
# Defaults to ./data (created on first write). Ignored in version control.
DATA_DIR=./data

# Optional. Sets NODE_ENV-like behaviour. Defaults to "development" if unset.
# In production, dev-login is disabled and session cookies are marked Secure.
NODE_ENV=development

# Optional. OAuth 2.0 client ID from Google Cloud Console. When set, the
# landing page renders the official Google Sign-In button (via Google
# Identity Services). When unset, the page falls back to the dev-only
# mock SSO button which 404s in production.
#
# Create the credential at:
#   https://console.cloud.google.com/apis/credentials
# Authorised JavaScript origins must include the dev/prod origin (e.g.
# http://localhost:5173, https://mathsdecoded.app).
GOOGLE_CLIENT_ID=
