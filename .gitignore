# Dependencies
node_modules/

# Build output
dist/

# TypeScript incremental build info
*.tsbuildinfo

# Editor / OS
.DS_Store
.vscode/
.idea/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local cache for the AI audio generator — caches the discovered TTS
# endpoint so we don't re-probe every run.
.audio-tts-endpoint

# Manim render artifacts (the lesson MP4 itself in
# public/video/lessons/... is checked in; only the build subdirs are
# gitignored).
public/video/videos/
public/video/images/
public/video/Tex/
public/video/texts/

# Python bytecode caches (transient, regenerated on every run).
__pycache__/
*.pyc

# Local env files (server reads $ANTHROPIC_AUTH_TOKEN at runtime — keep it out of git).
.env
.env.*
!.env.example

# Claude Code local state (sessions, plans, history, daemon logs, etc.)
.claude/

# Server-side progress JSON store. The directory itself is tracked (via
# `data/.gitkeep`) so first-write doesn't fail, but the contents are not.
data/progress.json
